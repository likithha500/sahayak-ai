def test_danger_sign_blocks_save_until_acknowledged(client, ws):
    before = len(visits(client))
    events = say(ws, "ASHA101 Anitha is pregnant and bleeding")
    alert = find(events, "danger_sign_detected")
    draft = find(events, "visit_draft")
    assert alert["requires_acknowledgement"] is True
    assert draft["blocked_by_alert"] is True and draft["beneficiary"]["beneficiary_id"] == "ASHA101"

    assert not find(say(ws, "yes"), "visit_saved")
    blocked = turn(ws, {"type": "confirm_visit", "revision": draft["revision"]})
    assert not find(blocked, "visit_saved") and "acknowledgement" in blocked[-1]["text"]
    assert len(visits(client)) == before

    ws.send_json({"type": "acknowledge_alert", "alert_id": alert["alert_id"]})
    assert ws.receive_json()["acknowledged"] is True
    saved = find(turn(ws, {"type": "confirm_visit", "revision": draft["revision"]}), "visit_saved")
    assert saved and saved["beneficiary_id"] == "ASHA101"


def test_switching_person_does_not_carry_over_old_fields(client, ws):
    say(ws, "Lakshmi newborn visit weight 2.8 kg")
    say(ws, "Hoskote")                                   # ASHA104, weight 2.8
    draft = find(say(ws, "asha 103 Meena child visit weight 12.4 kg"), "visit_draft")
    assert draft["beneficiary"]["beneficiary_id"] == "ASHA103"
    assert draft["visit"]["weight_kg"] == 12.4


