def test_demo_newborn_scenario_single_candidate_needs_explicit_yes(client, ws):
    before = len(visits(client))
    clar = find(say(ws, "Beneficiary 205 newborn baby weight 2.8 kilo hai. Next visit tomorrow."),
                "beneficiary_clarification")
    assert [c["beneficiary_id"] for c in clar["candidates"]] == ["AS-205"]
