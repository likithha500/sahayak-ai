def test_active_db_is_the_temp_db_and_seed_is_exact(client):
    assert str(database.DB_PATH) == os.environ["SAHAYAK_DB_PATH"]
    rows = {b["beneficiary_id"]: b for b in client.get("/api/beneficiaries").json()}
    expected = {
        "ASHA101": ("Anitha", "Rampura"), "ASHA102": ("Lakshmi", "Rampura"),
        "ASHA103": ("Meena", "Rampura"), "ASHA104": ("Lakshmi", "Hoskote"),
        "ASHA105": ("Suma", "Hoskote"),
    }
    for bid, (name, village) in expected.items():
        assert (rows[bid]["name"], rows[bid]["village"]) == (name, village)


def test_seed_never_overwrites_existing_records():
    with database.get_connection() as c:
        c.execute("UPDATE beneficiaries SET village='Changed' WHERE beneficiary_id='ASHA105'")
    database.initialize_database()
    database.initialize_database()
    row = next(b for b in database.list_beneficiaries() if b["beneficiary_id"] == "ASHA105")
    assert row["village"] == "Changed"
    with database.get_connection() as c:
        c.execute("UPDATE beneficiaries SET village='Hoskote' WHERE beneficiary_id='ASHA105'")


def test_frontend_demo_beneficiaries_exist_in_sqlite():
    mock = (Path(__file__).resolve().parent.parent / "src/data/mock.ts").read_text()
    demo = re.findall(r"\{id:'(AS-\d+)',name:'([^']+)'", mock)
    assert len(demo) == 6
