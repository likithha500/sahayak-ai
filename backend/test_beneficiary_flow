    with TestClient(main.app) as c:  # runs lifespan -> initialize_database
        yield c


def turn(ws, payload):
    """Send one event, return every event up to the final agent_reply."""
    ws.send_json(payload)
    events = []
    while True:
        event = ws.receive_json()
        events.append(event)
        if event["type"] in {"agent_reply", "session_error"}:
            return events


def say(ws, text):
    return turn(ws, {"type": "transcript_final", "text": text})


def find(events, kind):
    return next((e for e in events if e["type"] == kind), None)


def visits(client):
    return client.get("/api/visits").json()


@pytest.fixture
def ws(client):
    with client.websocket_connect("/ws/voice") as socket:
        assert socket.receive_json()["type"] == "session_connected"
        yield socket


