def test_meena_asha103_voice_to_sqlite_save(client, ws):
    before = len(visits(client))
    events = say(ws, "asha 103 Meena child visit weight 12.4 kg")
    draft = find(events, "visit_draft")
    assert draft["saved"] is False and draft["validated"] is True
    assert draft["awaiting_confirmation"] is True
    b = draft["beneficiary"]
    assert (b["beneficiary_id"], b["name"], b["village"]) == ("ASHA103", "Meena", "Rampura")
    assert len(visits(client)) == before            # draft is not a save

    events = say(ws, "yes")
    saved = find(events, "visit_saved")
    assert saved and saved["beneficiary_id"] == "ASHA103"
    row = next(v for v in visits(client) if v["id"] == saved["visit_id"])
    assert row["beneficiary_id"] == "ASHA103" and row["weight_kg"] == 12.4
    assert row["visit_type"] == "child"

    # a second "yes" must not save again
    assert not find(say(ws, "yes"), "visit_saved")
    assert len(visits(client)) == before + 1


def test_confirm_button_same_session_and_stale_revision(client, ws):
    before = len(visits(client))
    draft = find(say(ws, "Meena child visit weight 11.9 kg"), "visit_draft")
    rev = draft["revision"]

    stale = turn(ws, {"type": "confirm_visit", "revision": rev - 1})
    assert not find(stale, "visit_saved") and "out of date" in stale[-1]["text"]
    missing = turn(ws, {"type": "confirm_visit"})
    assert not find(missing, "visit_saved")
    assert len(visits(client)) == before

    saved = find(turn(ws, {"type": "confirm_visit", "revision": rev}), "visit_saved")
    assert saved and len(visits(client)) == before + 1
    assert any(v["id"] == saved["visit_id"] for v in visits(client))


def test_changed_draft_invalidates_old_confirm_revision(client, ws):
    before = len(visits(client))
    rev = find(say(ws, "Meena child visit weight 11.9 kg"), "visit_draft")["revision"]
    new = find(say(ws, "Actually weight is 3.2 kg"), "visit_draft")
    assert new["revision"] != rev
    assert not find(turn(ws, {"type": "confirm_visit", "revision": rev}), "visit_saved")
    assert len(visits(client)) == before
    assert find(turn(ws, {"type": "confirm_visit", "revision": new["revision"]}), "visit_saved")


def test_other_connection_cannot_confirm_this_draft(client, ws):
    before = len(visits(client))
    draft = find(say(ws, "Meena child visit weight 11.9 kg"), "visit_draft")
    with client.websocket_connect("/ws/voice") as other:
        other.receive_json()
        assert not find(turn(other, {"type": "confirm_visit", "revision": draft["revision"]}), "visit_saved")
        assert not find(say(other, "yes"), "visit_saved")
    assert len(visits(client)) == before


@pytest.mark.parametrize("answer,expected", [("Rampura", "ASHA102"), ("Hoskote", "ASHA104"), ("ASHA 102", "ASHA102")])
def test_duplicate_lakshmi_clarifies_then_saves_chosen_one(client, ws, answer, expected):
    before = len(visits(client))
    events = say(ws, "Lakshmi newborn visit weight 2.8 kg")
    clar = find(events, "beneficiary_clarification")
    assert clar and clar["reason"] == "duplicate_name"
    assert {c["beneficiary_id"] for c in clar["candidates"]} == {"ASHA102", "ASHA104"}
    assert "Rampura" in clar["message"] and "Hoskote" in clar["message"]
    assert not find(events, "visit_draft") and len(visits(client)) == before

    # "yes" must not pick a candidate or save anything when there are two
    assert not find(say(ws, "yes"), "visit_saved")

    draft = find(say(ws, answer), "visit_draft")
    assert draft["beneficiary"]["beneficiary_id"] == expected
    saved = find(say(ws, "yes"), "visit_saved")
    assert saved["beneficiary_id"] == expected
    assert next(v for v in visits(client) if v["id"] == saved["visit_id"])["beneficiary_id"] == expected


